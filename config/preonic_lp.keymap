#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// ============================================================================
// DÉFINITIONS DES TOUCHES - CANADIEN MULTILINGUE (CMS) via QWERTY US (Windows 11)
// ============================================================================
#define CA_EACU FSLH         // é (Touche '/' sur QWERTY US)
#define CA_EGRV QUOT         // è (Touche ''' sur QWERTY US)
#define CA_CCED RBRC         // ç (Touche ']' sur QWERTY US)
#define CA_AGRV BSLH         // à (Touche '\\' sur QWERTY US)
#define CA_UGRV RA(U)        // ù (Right Alt + '[')
#define CA_CIRC LBRC         // ^ (Touche morte '^' avec '[')

// Majuscules et caractères spéciaux
#define CA_CAP_EACU LS(FSLH)      // É
#define CA_CAP_EGRV LS(QUOT)      // È
#define CA_CAP_CCED LS(RBRC)      // Ç
#define CA_CAP_AGRV LS(BSLH)      // À
#define CA_CAP_UGRV LS(RA(U))     // Ù
#define CA_UML      LS(LBRC)      // ¨ (Touche morte '¨' avec Shift + '[')

#define BASE 0
#define NUMP 1
#define LOWER 2
#define RAISE 3
#define ADJUST 4

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    macros {
        // Macro pour ù (Accent grave AltGr + [ puis u)
        macro_ugrv: macro_ugrv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(LBKT) &kp U>;
        };

        // Macro pour Ù (Accent grave AltGr + [ puis Shift + U)
        macro_cap_ugrv: macro_cap_ugrv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(LBKT) &kp LS(U)>;
        };
    };


    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp BSPC
&kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P      &kp DEL
&tog NUMP  &kp A      &kp S      &kp D      &kp F      &kp G      &kp H      &kp J      &kp K      &kp L      &kp CA_EACU &kp CA_EGRV
&kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M      &kp COMMA  &kp DOT    &kp SEMI   &kp RET
&kp LCTRL  &kp GRAVE  &kp LGUI   &kp LALT   &mo LOWER  &kp SPACE  &kp SPACE  &mo RAISE  &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT
            >;
        };

        numpad_layer {
            display-name = "Numpad";
            bindings = <
&trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &kp KP_NUM &kp KP_DIVIDE &kp KP_MULTIPLY &kp KP_MINUS
&trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &kp KP_N7  &kp KP_N8     &kp KP_N9       &kp KP_PLUS
&trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &kp KP_N4  &kp KP_N5     &kp KP_N6       &kp KP_PLUS
&trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &kp KP_N1  &kp KP_N2     &kp KP_N3       &kp KP_ENTER
&trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &kp KP_N0     &kp KP_DOT      &kp KP_ENTER
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12
&kp BSLH   &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT  &kp QMARK  &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR   &kp PSCRN
&none      &none      &none      &none      &none      &none      &none      &kp UNDER  &kp PLUS   &kp CA_UML &kp CA_CAP_CCED &kp CA_CAP_AGRV
&none      &none      &none      &none      &none      &none      &none      &kp CA_CAP_AGRV &macro_cap_ugrv &kp HOME &kp END &none
&none      &none      &none      &none      &trans     &none      &none      &trans     &none      &none      &none      &none
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp FSLH   &kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp BSPC
&none      &none      &none      &none      &none      &none      &none      &none      &none      &none      &none      &kp DEL
&none      &none      &none      &none      &none      &none      &none      &kp MINUS  &kp EQUAL  &kp LBKT   &kp CA_CCED &kp CA_AGRV
&none      &none      &none      &none      &none      &none      &none      &kp CA_AGRV &macro_ugrv &kp LC(HOME) &kp LC(END) &kp C_PP
&none      &none      &none      &none      &trans     &none      &none      &trans     &kp C_PREV &kp C_NEXT &kp C_VOL_DN &kp C_VOL_UP
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&trans         &trans         &trans         &trans         &trans         &trans         &trans     &trans     &trans     &trans     &trans     &trans
&trans         &sys_reset     &bootloader    &trans         &trans         &trans         &trans     &trans     &trans     &trans     &trans     &trans
&bt BT_CLR     &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &trans     &trans     &trans     &trans     &trans     &trans
&out OUT_USB   &out OUT_BLE   &trans         &trans         &trans         &trans         &trans     &trans     &trans     &trans     &trans     &trans
&trans         &trans         &trans         &trans         &trans         &trans         &trans     &trans     &trans     &trans     &trans     &trans
            >;
        };
    };
};
